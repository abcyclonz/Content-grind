# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
TTS_API_KEY=
# Google Cloud TTS (Chirp 3 HD): path to a service-account key JSON, kept outside this folder.
GOOGLE_TTS_CREDENTIALS_FILE=
IMAGE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Path to the OAuth client JSON downloaded from Google Cloud. Keep it outside this folder.
YOUTUBE_CLIENT_SECRET_FILE=
# 1 = no paid API calls and no upload; fixtures are used instead.
DRY_RUN=1
# Client ID of your Twitch app (dev.twitch.tv/console, client type "Public"). No secret needed.
TWITCH_CLIENT_ID=
# Optional: where network.db and jobs/ live. Defaults to ./data
# NETWORK_DATA_DIR=
